{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenMD安装程序",
  "version": "10.0.0",
  "identifier": "com.OpenMD.installer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMD 安装程序",
        "width": 720,
        "height": 450,
        "minWidth": 720,
        "minHeight": 450,
        "maxWidth": 720,
        "maxHeight": 450,
        "resizable": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.ico"
    ]
  }
}
