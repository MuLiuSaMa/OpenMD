{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMD",
  "version": "1.0.2",
  "identifier": "OpenMD",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenMD",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "decorations": false,
        "devtools": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.gitcode.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "shortDescription": "简洁 美观 高效的 Markdown 查看器",
    "copyright": "OpenMD",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [".md", ".markdown", ".mdown", ".mkd"],
        "name": "OpenMD Markdown Document",
        "description": "Markdown 文档(OpenMD 查看)",
        "role": "Viewer"
      }
    ]
  }
}
